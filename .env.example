# 복사해서 .env로 저장 후 값 채우기 (.env는 gitignore됨)
# T3Q 플랫폼 (재난안전계획서 생성 API + LLM)
T3Q_BASE_URL=https://plf.mois-disaster.t3q.ai
# TLS: certs/cadm-ca.crt 기본. 인증서 체인 불일치 해결 전까지는 false로 우회
# (docs/t3q_upgrade_design.md §6 참조)
T3Q_TLS_VERIFY=true
#T3Q_CA_PATH=certs/cadm-ca.crt
T3Q_TIMEOUT=600
T3Q_LLM_MODEL=mois

# LLM 생성 길이 상한 (0이면 미전송)
LLM_MAX_TOKENS=4096

HOST=127.0.0.1
PORT=8080
